{
	"info": {
		"name": "AI Smart Complaint System API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth: Signup",
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"postman@example.com\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/signup",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "signup"]
				}
			}
		},
		{
			"name": "2. Auth: Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"token\", jsonData.token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"postman@example.com\",\n  \"password\": \"123456\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": ["{{baseUrl}}"],
					"path": ["api", "auth", "login"]
				}
			}
		},
		{
			"name": "3. Complaints: Get All (GET)",
			"request": {
				"method": "GET",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"}
				],
				"url": {
					"raw": "{{baseUrl}}/api/complaints",
					"host": ["{{baseUrl}}"],
					"path": ["api", "complaints"]
				}
			}
		},
		{
			"name": "4. Complaints: Create (POST)",
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "Authorization", "value": "Bearer {{token}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Broken Streetlight\",\n  \"description\": \"Streetlight is completely broken and causing accidents.\",\n  \"category\": \"Electricity\",\n  \"location\": \"Main Road Sector 4\",\n  \"aiPriority\": \"High\",\n  \"aiDepartment\": \"Electricity Board\",\n  \"aiSummary\": \"Broken streetlight needs repair.\",\n  \"aiResponse\": \"We have forwarded this to the Electricity Board.\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/complaints",
					"host": ["{{baseUrl}}"],
					"path": ["api", "complaints"]
				}
			}
		},
		{
			"name": "5. Complaints: Update Status (PUT)",
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "Authorization", "value": "Bearer {{token}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"Resolved\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/complaints/REPLACE_WITH_COMPLAINT_ID",
					"host": ["{{baseUrl}}"],
					"path": ["api", "complaints", "REPLACE_WITH_COMPLAINT_ID"]
				}
			}
		},
		{
			"name": "6. Complaints: Delete (DELETE)",
			"request": {
				"method": "DELETE",
				"header": [
					{"key": "Authorization", "value": "Bearer {{token}}"}
				],
				"url": {
					"raw": "{{baseUrl}}/api/complaints/REPLACE_WITH_COMPLAINT_ID",
					"host": ["{{baseUrl}}"],
					"path": ["api", "complaints", "REPLACE_WITH_COMPLAINT_ID"]
				}
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:5000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	]
}
